[Unit]
Description=VANT-SIEM SOC SOAR consumer (auto reports)
After=network.target postgresql.service redis-server.service vantsiem-soc.service
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=leonardo
WorkingDirectory=/opt/vant-siem/services/vant-soc
Environment=PATH=/opt/vant-siem/venv/bin:/usr/bin:/bin
EnvironmentFile=/opt/vant-siem/.env
ExecStart=/opt/vant-siem/venv/bin/python /opt/vant-siem/services/vant-soc/manage.py consume_soar_events --group vant-soc-soar
Restart=always
RestartSec=10
StandardOutput=append:/var/log/vant/soc-soar.log
StandardError=append:/var/log/vant/soc-soar.log

[Install]
WantedBy=multi-user.target

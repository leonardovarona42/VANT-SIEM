# VANT-SIEM Environment Configuration
# Copy to .env and customize

# ===== Service Identity =====
VANT_SERVICE_NAME=vant-siem
MICROSERVICE_MODE=standalone  # standalone | docker

# ===== Database - Web Portal =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vant_siem
DB_USER=vantsiem
DB_PASSWORD=change-me-in-production

# ===== Database - Logs Service =====
LOGS_DB_HOST=localhost
LOGS_DB_PORT=5433
LOGS_DB_NAME=vant_logs
LOGS_DB_USER=vantsiem
LOGS_DB_PASSWORD=change-me-in-production

# ===== Database - Incidents Service =====
INCIDENTS_DB_HOST=localhost
INCIDENTS_DB_PORT=5434
INCIDENTS_DB_NAME=vant_incidents
INCIDENTS_DB_USER=vantsiem
INCIDENTS_DB_PASSWORD=change-me-in-production

# ===== Database - Assets Service =====
ASSETS_DB_HOST=localhost
ASSETS_DB_PORT=5435
ASSETS_DB_NAME=vant_assets
ASSETS_DB_USER=vantsiem
ASSETS_DB_PASSWORD=change-me-in-production

# ===== Database - Network Service =====
NETWORK_DB_HOST=localhost
NETWORK_DB_PORT=5436
NETWORK_DB_NAME=vant_network
NETWORK_DB_USER=vantsiem
NETWORK_DB_PASSWORD=change-me-in-production

# ===== Database - DLP Service =====
DLP_DB_HOST=localhost
DLP_DB_PORT=5437
DLP_DB_NAME=vant_dlp
DLP_DB_USER=vantsiem
DLP_DB_PASSWORD=change-me-in-production

# ===== Redis =====
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
SERVICE_BUS_URL=redis://localhost:6379/10

# ===== Service URLs =====
LOGS_SERVICE_URL=http://localhost:9201
INCIDENTS_SERVICE_URL=http://localhost:8001
ASSETS_SERVICE_URL=http://localhost:8002
NETWORK_SERVICE_URL=http://localhost:8004
AI_SERVICE_URL=http://localhost:8003

# ===== Django =====
SECRET_KEY=change-this-to-a-secure-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ===== Timezone =====
TIME_ZONE=America/Havana

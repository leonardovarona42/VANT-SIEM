# VANT-SIEM Microservices — Environment Variables
# Copy to /opt/vant-siem/.env on server

# === PostgreSQL ===
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=vantsiem
POSTGRES_PASSWORD=vantsiem

# === Redis ===
REDIS_URL=redis://127.0.0.1:6379/0

# === JWT Auth ===
JWT_SECRET=vantsiem-jwt-secret-2026-change-in-production
JWT_ACCESS_TTL=1800
JWT_REFRESH_TTL=604800

# === Service Secrets (inter-service) ===
SERVICE_SECRET=vantsiem-service-secret-2026-change-in-production

# === Service URLs ===
AUTH_SERVICE_URL=http://127.0.0.1:8100
WEB_SERVICE_URL=http://127.0.0.1:8200
INVENTORY_SERVICE_URL=http://127.0.0.1:8300
LOGS_SERVICE_URL=http://127.0.0.1:8400
AEGIS_SERVICE_URL=http://127.0.0.1:8500
BUS_SERVICE_URL=http://127.0.0.1:8600

# === Alert Channels ===
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_HOST=smtp.example.com
ALERT_EMAIL_PORT=587
ALERT_EMAIL_USER=alerts@vantsiem.com
ALERT_EMAIL_PASS=changeme
ALERT_EMAIL_FROM=alerts@vantsiem.com

ALERT_TELEGRAM_ENABLED=false
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=

# === Redis Stream Config ===
REDIS_STREAM_MAX_LEN=100000

# === MinIO (Evidence Storage) ===
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=vantsiem
MINIO_SECRET_KEY=vantsiem123
MINIO_BUCKET=dlp-evidence

# === Agent Defaults ===
AGENT_DLP_SCAN_INTERVAL=30
AGENT_INVENTORY_INTERVAL=300
AGENT_HEARTBEAT_INTERVAL=60

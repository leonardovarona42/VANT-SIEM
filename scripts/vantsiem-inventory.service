[Unit]
Description=VANT-SIEM Inventory Service (:8300)
After=network.target postgresql.service redis-server.service vantsiem-auth.service
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=leonardo
WorkingDirectory=/opt/vant-siem/services/vant-inventory
Environment=PATH=/opt/vant-siem/venv/bin:/usr/bin:/bin
EnvironmentFile=/opt/vant-siem/.env
ExecStart=/opt/vant-siem/venv/bin/gunicorn --config /opt/vant-siem/services/vant-inventory/gunicorn.conf.py
Restart=always
RestartSec=5
StandardOutput=append:/var/log/vant/inventory.log
StandardError=append:/var/log/vant/inventory.log

[Install]
WantedBy=multi-user.target
